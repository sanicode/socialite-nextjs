# Copy file ini ke lokasi aman di server, misalnya:
# /etc/socialite-backup.env
#
# Jangan commit credential asli.

# Opsional. Jika kosong, script memakai DATABASE_URL dari .env aplikasi.
BACKUP_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Folder penyimpanan backup lokal.
BACKUP_LOCAL_DIR="/var/backups/socialite"
BACKUP_RETENTION_DAYS="7"

# Opsional. Isi jika backup perlu dikirim ke server lain via SCP.
# Format: user@host:/path/tujuan
BACKUP_REMOTE_TARGET=""
BACKUP_REMOTE_RETENTION_DAYS="30"
BACKUP_SSH_KEY="/home/app/.ssh/socialite-backup"
BACKUP_SSH_PORT="22"
